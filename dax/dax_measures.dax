// =============================================
// ОБЩИЕ АГРЕГАЦИИ И ПОТЕРИ
// =============================================

Сумма_Брака = 
SUM('Брак'[Кол_брака])

Количество_поломок = 
COUNTROWS('Таблица_простои')

Общие_часы_простоя = 
SUMX(
    'Таблица_простои', 
    DATEDIFF('Таблица_простои'[Дата_Начала], 'Таблица_простои'[Дата_Окончания], MINUTE) / 60
)

Общая_стоимость_потерь = 
SUMX(
    'Таблица_простои', 
    [Общие_часы_простоя] * 'Таблица_простои'[Стоимость_1_часа (руб.)]
)

// =============================================
// МЕРЫ КАЧЕСТВА И ДОЛЕЙ
// =============================================

%_Брака = 
DIVIDE(
    [Сумма_Брака], 
    [Сумма_Брака] + SUM('Брак'[Кол_годных]), 
    0
)

%_простоев_цех = 
DIVIDE(
    [Общие_часы_простоя], 
    CALCULATE([Общие_часы_простоя], ALL('Справочник_цехов'[Цех]))
)

// =============================================
// ОТРАСЛЕВЫЕ KPI (ТОиР И НАДЕЖНОСТЬ)
// =============================================

Среднее время ремонта (MTTR) = 
DIVIDE(
    [Общие_часы_простоя], 
    [Количество_поломок], 
    0
)

MTBF (Среднее время между отказами) = 
VAR TotalAvailableTime = CALCULATE(COUNTROWS('Справочник_оборудования') * 720)
VAR FailureCount = COUNTROWS('Таблица_простои')
RETURN
    DIVIDE(
        TotalAvailableTime - [Общие_часы_простоя], 
        FailureCount, 
        0
    )

// =============================================
// ФИНАНСОВЫЕ РИСКИ И СТАТУСЫ KPI
// =============================================

Средняя_стоимость_случая = 
DIVIDE(
    [Общая_стоимость_потерь], 
    [Количество_поломок], 
    0
)

KPI_Статус = 
IF(
    [Средняя_Стоимость_Случая] > 50000,
    "🔴 Критично", 
    "🟢 В норме"
)